{
  "name": "prorium-shareholder-report",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --conditions=react-server --import tsx --test --test-isolation=none tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run db:migrations:check",
    "release:check": "node scripts/release-check.mjs",
    "db:migrations:prepare": "node scripts/prepare-migrations.mjs",
    "db:migrations:check": "node scripts/prepare-migrations.mjs --check",
    "db:bootstrap:prepare": "node scripts/prepare-bootstrap.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.0",
    "@sparticuz/chromium": "153.0.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "playwright-core": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "supabase": "2.119.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
