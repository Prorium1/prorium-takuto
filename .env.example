# MOCK ONLY. Do not put production credentials or financial data here.
# npm run dev enables the mock environment automatically.
# To run a LOCAL production build with mock data: PRORIUM_ENV=mock npm start
# Production/preview settings belong to separate hosting environment scopes.
PRORIUM_ENV=mock
PDF_CHROMIUM_PATH=/usr/bin/chromium
INTERNAL_APP_ORIGIN=http://127.0.0.1:3000

# Vercel Preview ONLY: generate a unique random secret of at least 32 characters
# in the hosting environment. Never commit its value. Required for demo login.
# MOCK_SESSION_SECRET=

# Set these ONLY in the dedicated production hosting environment.
# Preview must use mock data and must not receive production credentials.
# PRORIUM_ENV=production
# SUPABASE_URL=https://YOUR_DEDICATED_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=     # sb_publishable_... (not a service-role/secret key)
# PRORIUM_COMPANY_ID=          # UUID returned by reviewed admin bootstrap
# APP_ORIGIN=https://YOUR_IR_DOMAIN
# OPENAI_API_KEY=              # optional, server-only secure setup; never commit
# OPENAI_SUMMARY_MODEL=gpt-5-mini
# freee IR OAuth app: Production scope only. Do not paste values into chat or Git.
# FREEE_CLIENT_ID=
# FREEE_CLIENT_SECRET=
# FREEE_COMPANY_ID=11486508
# FREEE_TOKEN_ENCRYPTION_KEY=  # 32 random bytes encoded as base64
